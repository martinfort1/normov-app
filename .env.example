# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Poné 1 cuando Google esté configurado en Supabase (muestra el botón en el login)
NEXT_PUBLIC_GOOGLE_LOGIN=0

# Solo para scripts/import-sheets.ts y src/app/api/sync/route.ts. NUNCA con prefijo NEXT_PUBLIC_ ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=

# Secreto compartido con los Apps Script de las planillas (ver apps-script/). Generalo con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
SYNC_SECRET=
